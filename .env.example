# CodeManthan Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key - for Quiz Generation (PDF to Quiz + Personalized Onboarding Quiz)
# Get your key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Gemini API Key (Google) - for AI Learning Path generation and embeddings
# Get your key from: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Claude API Key (Anthropic) - for AI Topic Explainer (fallback for learning path)
# Get your key from: https://console.anthropic.com/
VITE_CLAUDE_API_KEY=

# Qdrant Vector Database - for semantic search, RAG-powered PDF quiz, and personalized learning
# Sign up free at: https://cloud.qdrant.io/ (1GB free tier)
VITE_QDRANT_URL=
VITE_QDRANT_API_KEY=
